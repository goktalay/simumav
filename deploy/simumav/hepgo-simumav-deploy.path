# SIMUMAV otomatik yayın tetikleyicisi (root). Hesap servisi (hepgo kullanıcısı) POST /api/sv/web-releases ile paketi
# /opt/hepgo/sshmaster/data/releases/sv/<v>/ altına yazar ve `latest` dosyasını atomik olarak yeniler; bu unit o dosyayı izler.
# Kurulum: cp hepgo-simumav-deploy.{path,service} /etc/systemd/system/ && systemctl daemon-reload &&
#          systemctl enable --now hepgo-simumav-deploy.path
[Unit]
Description=SIMUMAV yeni sürüm izleyicisi (releases/sv/latest)

[Path]
PathChanged=/opt/hepgo/sshmaster/data/releases/sv/latest
PathExists=/opt/hepgo/sshmaster/data/releases/sv/latest
Unit=hepgo-simumav-deploy.service
MakeDirectory=yes
DirectoryMode=0755

[Install]
WantedBy=multi-user.target
